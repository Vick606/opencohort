# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. Never commit real credentials.

# Neon Postgres connection string.
# Get it from the Neon dashboard: Project -> Connection Details -> Connection string.
# Use the POOLED host (it contains "-pooler") for serverless/Vercel.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/opencohort?sslmode=require"

# Better Auth — generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""

# The app's public URL. http://localhost:3000 in development.
BETTER_AUTH_URL="http://localhost:3000"
