# Copy this file to .env.local and fill in the values.
#
#   Copy-Item .env.example .env.local
#
# .env.local is gitignored. Never commit real credentials.
#
# Both this file and .env.local are read by drizzle-kit (see drizzle.config.ts)
# and .env.local is what Next.js loads at runtime. .env.local wins.

# ─── Database ────────────────────────────────────────────────────────────────
#
# Neon connection string. Get it from the Neon dashboard:
#   Project -> Connection Details -> Connection string
#
# Use the POOLED host for anything deployed (Vercel) — it contains "-pooler".
# The direct host also works locally. Keep ?sslmode=require.
#
# Verify it with: npm run db:check
#
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/opencohort?sslmode=require"

# ─── Auth (slice 3, not needed yet) ──────────────────────────────────────────
#
# Generate a secret with: npx @better-auth/cli secret
#
BETTER_AUTH_SECRET=""

# The app's public URL. http://localhost:3000 in development.
# In production this becomes the Vercel domain.
#
BETTER_AUTH_URL="http://localhost:3000"
